package templates

templ Dashboard() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Admin | Chinook Go</title>
			<link rel="stylesheet" type="text/css" href="/lib/w2ui.min.css"/>
			<link rel="stylesheet" type="text/css" href="/lib/w2ui.dark.css"/>
			<link rel="stylesheet" type="text/css" href="/lib/font-awesome/css/all.min.css"/>
			<link rel="stylesheet" type="text/css" href="/lib/codemirror/codemirror.min.css"/>
			<link rel="stylesheet" type="text/css" href="/lib/codemirror/addon/hint/show-hint.min.css"/>
			<link rel="stylesheet" type="text/css" href="/lib/codemirror/theme/dracula.min.css"/>
			<script defer src="/lib/codemirror/codemirror.min.js"></script>
			<script defer src="/lib/codemirror/keymap/vim.min.js"></script>
			<script defer src="/lib/codemirror/mode/sql/sql.min.js"></script>
			<script defer src="/lib/codemirror/addon/hint/show-hint.min.js"></script>
			<script defer src="/lib/codemirror/addon/hint/sql-hint.min.js"></script>
			<style>
				* {
					margin: 0;
					padding: 0;
					box-sizing: border-box;
				}
			</style>
		</head>
		<body>
			<div id="dashboard-layout" style="width: 100vw; height: 100vh; min-width: 1000px;"></div>
			<script type="module" src="/admin/dashboard.js"></script>
		</body>
	</html>
}
